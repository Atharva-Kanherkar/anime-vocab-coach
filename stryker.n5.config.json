{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "src/lib/course-listening.ts",
    "src/lib/listening-coordination.ts",
    "src/lib/capture-starts.ts"
  ],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.n5-mutation.config.ts"
  },
  "coverageAnalysis": "perTest",
  "reporters": [
    "clear-text",
    "json",
    "html"
  ],
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 90
  },
  "concurrency": 3,
  "ignorePatterns": [
    "backend/**",
    "web/**",
    "extension/**",
    "reels/**",
    "dist/**",
    "docs/**"
  ],
  "jsonReporter": {
    "fileName": "reports/n5-mutation/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/n5-mutation/mutation.html"
  }
}
