NEXT_PUBLIC_API_BASE=https://api.animevocab.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key
CLERK_SECRET_KEY=sk_test_your_key
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app
# AI coach (issue #13). In production set OPENAI_API_KEY as a Worker secret instead.
OPENAI_API_KEY=sk-your-openai-key
AI_COACH_MODEL=gpt-5.6-luna
# Optional: none | low | medium | high | xhigh | max. Omit to use OpenAI's
# documented medium default for GPT-5.6.
# Two meters — keep in sync with TIERS in src/lib/site.ts and wrangler.jsonc.
# *_AI_CALLS_PER_MONTH is the advertised allowance (explain / hooks / chat /
# notebook summaries). *_AUTO_* covers what the extension fires on its own
# (word picking, per-line extraction, pronunciation audio), which must never
# eat the advertised number. Unset values fall back to these same defaults.
FREE_AI_CALLS_PER_MONTH=300
PRO_AI_CALLS_PER_MONTH=2500
MAX_AI_CALLS_PER_MONTH=6000
FREE_AUTO_AI_CALLS_PER_MONTH=1200
PRO_AUTO_AI_CALLS_PER_MONTH=8000
MAX_AUTO_AI_CALLS_PER_MONTH=15000

# Resend (production: RESEND_API_KEY as Worker secret; FROM/REPLY_TO are plaintext vars).
RESEND_API_KEY=re_your_key
EMAIL_FROM=Anime Vocab <atharva@animevocab.com>
EMAIL_REPLY_TO=atharvakanherkar25@gmail.com

# Meta Pixel (Instagram/Facebook ads) — optional
NEXT_PUBLIC_META_PIXEL_ID=

# /owner dashboard reads. Telemetry is WRITTEN via the Analytics Engine
# bindings in wrangler.jsonc and needs nothing here; these only let the
# dashboard query it back.
# In production CF_ACCOUNT_ID is a plaintext var in wrangler.jsonc and the
# token is a Worker secret (`npx wrangler secret put CF_ANALYTICS_API_TOKEN`).
# Create the token at dash.cloudflare.com/profile/api-tokens with the
# "Account Analytics: Read" permission scoped to this account.
CF_ACCOUNT_ID=68b4f7e6d89fd7ac4cbf3243fe190b5f
CF_ANALYTICS_API_TOKEN=
