{
  "name": "anime-vocab-coach",
  "version": "1.0.0",
  "description": "Learn Japanese from anime — Chrome extension with romaji-first SRS, Listening Mode, and optional cloud sync. Site: animevocab.com",
  "homepage": "https://animevocab.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Atharva-Kanherkar/anime-vocab-coach.git"
  },
  "bugs": {
    "url": "https://github.com/Atharva-Kanherkar/anime-vocab-coach/issues"
  },
  "author": "Atharva Kanherkar (https://animevocab.com)",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "node e2e/extension-review.mjs",
    "test:e2e:onboarding": "node e2e/onboarding.mjs",
    "test:e2e:youtube": "node e2e/youtube-session.mjs",
    "test:e2e:youtube:followups": "node e2e/youtube-followups.mjs",
    "test:e2e:learning-loop": "node e2e/learning-loop.mjs",
    "build-dict": "node scripts/build-dictionary.mjs",
    "funnel:weekly": "node scripts/weekly-funnel.mjs",
    "kv:sweep-sync-tokens": "node scripts/purge-immortal-sync-tokens.mjs",
    "pack": "npm run typecheck && npm run build && mkdir -p dist && rm -f dist/anime-vocab-coach.zip && cd extension && zip -rq ../dist/anime-vocab-coach.zip . -x 'icons/icon.svg' -x '*.DS_Store' && cd .. && echo 'Built dist/anime-vocab-coach.zip'",
    "deploy:site": "cd web && npm run deploy",
    "deploy:api": "cd backend && npm ci && npx wrangler deploy --config wrangler.toml"
  },
  "keywords": [
    "japanese",
    "anime",
    "language-learning",
    "chrome-extension",
    "spaced-repetition",
    "vocabulary",
    "crunchyroll",
    "netflix",
    "romaji",
    "immersion"
  ],
  "dependencies": {
    "kuromoji": "^0.1.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "esbuild": "^0.28.1",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
